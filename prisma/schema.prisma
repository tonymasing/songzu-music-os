generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Song {
  id                  String                      @id @default(cuid())
  title               String
  workingTitle        String?
  status              String                      @default("IDEA")
  bpm                 Int?
  musicalKey          String?
  genre               String?
  subgenre            String?
  language            String?                     @default("zh-TW")
  moodJson            String?
  summary             String?
  notes               String?
  createdOn           DateTime?
  targetReleaseDate   DateTime?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  lyricsVersions      LyricsVersion[]
  audioFiles          AudioFile[]
  credits             Credit[]
  releaseTracks       ReleaseTrack[]
  tasks               Task[]
  statusHistory       StatusHistory[]
  aiSuggestions       AiSuggestion[]
  inspirations        Inspiration[]
  timelineEvents      TimelineEvent[]
  promoAssets         PromoAsset[]
  garageBandLogs      GarageBandOperationLog[]
  pitchPackSongs      PitchPackSong[]
  recordingSessions   RecordingSession[]
  recordingTakes      RecordingTake[]
  performanceReports  PerformanceAnalysisReport[]
  performanceIssues   PerformanceIssue[]
  soundUsages         SongSoundUse[]
  setupChecklistItems SongSetupChecklistItem[]
  musicMaterials      MusicMaterial[]
  generationDrafts    MusicGenerationDraft[]
  dawProjects         DawProject[]
  platformPublishJobs PlatformPublishJob[]
  revenueRecords      RevenueRecord[]
  songPreview         SongPreview?
  knowledgeNodes      KnowledgeNode[]
  intelligenceJobs    AudioIntelligenceJob[]
  automationRuns      AutomationRun[]
  catalogMatches      CatalogMatch[]
  rightsProfile       SongRightsProfile?
  industryExports     IndustryExport[]
  metricSnapshots     PlatformMetricSnapshot[]
  audienceEvents      AudienceEvent[]

  @@index([status])
  @@index([genre])
  @@index([updatedAt])
}

model LyricsVersion {
  id           String   @id @default(cuid())
  songId       String
  versionName  String
  content      String
  sectionsJson String?
  isPrimary    Boolean  @default(false)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  song         Song     @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@index([songId])
}

model AudioFile {
  id                          String                      @id @default(cuid())
  songId                      String
  fileName                    String
  filePath                    String?
  storageProvider             String                      @default("local")
  fileType                    String
  versionName                 String?
  fileSizeBytes               Int?
  sha256                      String?
  originalFileName            String?
  mimeType                    String?
  codecName                   String?
  containerFormat             String?
  sourceKind                  String                      @default("external_path")
  parentAudioFileId           String?
  originGarageBandLogId       String?
  qualityStatus               String                      @default("pending")
  isProtectedOriginal         Boolean                     @default(true)
  durationSeconds             Float?
  sampleRate                  Int?
  bitDepth                    Int?
  lufs                        Float?
  truePeak                    Float?
  isPrimary                   Boolean                     @default(false)
  archivedAt                  DateTime?
  notes                       String?
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt
  song                        Song                        @relation(fields: [songId], references: [id], onDelete: Cascade)
  comments                    AudioComment[]
  analyses                    AudioAnalysis[]
  qualityReports              AudioQualityReport[]
  parentAudioFile             AudioFile?                  @relation("AudioFileLineage", fields: [parentAudioFileId], references: [id], onDelete: SetNull)
  childAudioFiles             AudioFile[]                 @relation("AudioFileLineage")
  originGarageBandLog         GarageBandOperationLog?     @relation(fields: [originGarageBandLogId], references: [id], onDelete: SetNull)
  referencedRecordingSessions RecordingSession[]          @relation("RecordingSessionReference")
  recordingTakes              RecordingTake[]             @relation("RecordingTakeAudioFile")
  performanceReports          PerformanceAnalysisReport[] @relation("PerformanceReportAudioFile")
  performanceIssues           PerformanceIssue[]          @relation("PerformanceIssueAudioFile")
  dawClips                    DawClip[]
  dawScoreDrafts              DawScoreDraft[]
  previewSources              SongPreview[]               @relation("SongPreviewSource")
  intelligenceJobs            AudioIntelligenceJob[]

  @@index([songId])
  @@index([fileType])
  @@index([qualityStatus])
  @@index([sha256])
  @@index([parentAudioFileId])
  @@index([originGarageBandLogId])
  @@index([archivedAt])
}

model AudioQualityReport {
  id                  String    @id @default(cuid())
  audioFileId         String
  sha256              String?
  fileSizeBytes       Int?
  formatName          String?
  containerFormat     String?
  codecName           String?
  sampleRate          Int?
  bitDepth            Int?
  bitRate             Int?
  channels            Int?
  durationSeconds     Float?
  peak                Float?
  rms                 Float?
  integratedLufs      Float?
  truePeak            Float?
  clippingSampleCount Int       @default(0)
  clippingRisk        Boolean   @default(false)
  lowQualityRisk      Boolean   @default(false)
  sampleRateMismatch  Boolean   @default(false)
  bitDepthMismatch    Boolean   @default(false)
  warningsJson        String?
  metricsJson         String?
  verdict             String    @default("warning")
  analyzer            String    @default("ffmpeg")
  analyzerVersion     String?
  errorMessage        String?
  createdAt           DateTime  @default(now())
  audioFile           AudioFile @relation(fields: [audioFileId], references: [id], onDelete: Cascade)

  @@index([audioFileId])
  @@index([verdict])
  @@index([sha256])
}

model AudioComment {
  id               String    @id @default(cuid())
  audioFileId      String
  songId           String
  timestampSeconds Float
  body             String
  category         String    @default("其他")
  status           String    @default("TODO")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  audioFile        AudioFile @relation(fields: [audioFileId], references: [id], onDelete: Cascade)

  @@index([audioFileId])
  @@index([songId])
  @@index([status])
}

model AudioAnalysis {
  id                   String    @id @default(cuid())
  audioFileId          String
  durationSeconds      Float?
  peak                 Float?
  rms                  Float?
  energyJson           String?
  waveformJson         String?
  suggestedBpm         Float?
  suggestedMoodJson    String?
  suggestedUseCaseJson String?
  createdAt            DateTime  @default(now())
  audioFile            AudioFile @relation(fields: [audioFileId], references: [id], onDelete: Cascade)

  @@index([audioFileId])
}

model RecordingSession {
  id                   String          @id @default(cuid())
  songId               String
  targetInstrument     String
  detectionMode        String          @default("timing_pitch")
  targetBpm            Int?
  targetKey            String?
  metronomeEnabled     Boolean         @default(true)
  referenceAudioFileId String?
  status               String          @default("ACTIVE")
  notes                String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  song                 Song            @relation(fields: [songId], references: [id], onDelete: Cascade)
  referenceAudioFile   AudioFile?      @relation("RecordingSessionReference", fields: [referenceAudioFileId], references: [id], onDelete: SetNull)
  takes                RecordingTake[]

  @@index([songId])
  @@index([targetInstrument])
  @@index([status])
  @@index([referenceAudioFileId])
}

model RecordingTake {
  id           String                      @id @default(cuid())
  sessionId    String
  songId       String
  audioFileId  String?
  takeNumber   Int                         @default(1)
  label        String
  status       String                      @default("RECORDED")
  recordedAt   DateTime                    @default(now())
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt
  session      RecordingSession            @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  song         Song                        @relation(fields: [songId], references: [id], onDelete: Cascade)
  audioFile    AudioFile?                  @relation("RecordingTakeAudioFile", fields: [audioFileId], references: [id], onDelete: SetNull)
  reports      PerformanceAnalysisReport[]
  issues       PerformanceIssue[]
  dawTakeLanes DawTakeLane[]

  @@index([sessionId])
  @@index([songId])
  @@index([audioFileId])
  @@index([status])
}

model PerformanceAnalysisReport {
  id                  String             @id @default(cuid())
  recordingTakeId     String
  songId              String
  audioFileId         String?
  analyzer            String             @default("browser_web_audio")
  detectionMode       String             @default("timing_pitch")
  overallScore        Int
  timingScore         Int?
  pitchScore          Int?
  levelScore          Int?
  durationSeconds     Float?
  peak                Float?
  rms                 Float?
  tempoDriftMs        Float?
  pitchDriftCents     Float?
  summary             String
  recommendationsJson String?
  metricsJson         String?
  createdAt           DateTime           @default(now())
  recordingTake       RecordingTake      @relation(fields: [recordingTakeId], references: [id], onDelete: Cascade)
  song                Song               @relation(fields: [songId], references: [id], onDelete: Cascade)
  audioFile           AudioFile?         @relation("PerformanceReportAudioFile", fields: [audioFileId], references: [id], onDelete: SetNull)
  issues              PerformanceIssue[]

  @@index([recordingTakeId])
  @@index([songId])
  @@index([audioFileId])
  @@index([overallScore])
}

model PerformanceIssue {
  id               String                    @id @default(cuid())
  reportId         String
  recordingTakeId  String
  songId           String
  audioFileId      String?
  timestampSeconds Float
  issueType        String
  severity         String                    @default("medium")
  title            String
  detail           String
  suggestion       String?
  measuredValue    Float?
  expectedValue    Float?
  createdAt        DateTime                  @default(now())
  report           PerformanceAnalysisReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  recordingTake    RecordingTake             @relation(fields: [recordingTakeId], references: [id], onDelete: Cascade)
  song             Song                      @relation(fields: [songId], references: [id], onDelete: Cascade)
  audioFile        AudioFile?                @relation("PerformanceIssueAudioFile", fields: [audioFileId], references: [id], onDelete: SetNull)

  @@index([reportId])
  @@index([recordingTakeId])
  @@index([songId])
  @@index([audioFileId])
  @@index([issueType])
  @@index([severity])
}

model DawProject {
  id              String                    @id @default(cuid())
  songId          String
  title           String
  bpm             Int?
  musicalKey      String?
  sampleRate      Int                       @default(48000)
  bitDepth        Int                       @default(24)
  timeSignature   String                    @default("4/4")
  status          String                    @default("DRAFT")
  engineMode      String                    @default("web_fallback")
  projectJson     String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  song            Song                      @relation(fields: [songId], references: [id], onDelete: Cascade)
  tracks          DawTrack[]
  markers         DawMarker[]
  mixSnapshots    DawMixSnapshot[]
  scoreDrafts     DawScoreDraft[]
  latencyProfiles DawLatencyProfile[]
  healthSnapshots DawEngineHealthSnapshot[]
  editOperations  DawEditOperation[]
  routes          DawRoute[]
  recoveryEntries DawRecoveryEntry[]

  @@index([songId])
  @@index([status])
}

model DawTrack {
  id               String              @id @default(cuid())
  projectId        String
  name             String
  trackType        String              @default("audio")
  sortOrder        Int                 @default(0)
  muted            Boolean             @default(false)
  solo             Boolean             @default(false)
  armed            Boolean             @default(false)
  monitoring       Boolean             @default(false)
  volume           Float               @default(1)
  pan              Float               @default(0)
  color            String?
  effectsJson      String?
  inputSource      String?
  outputTarget     String              @default("master")
  polarityInverted Boolean             @default(false)
  stereoMode       String              @default("stereo")
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  project          DawProject          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clips            DawClip[]
  takeLanes        DawTakeLane[]
  outgoingRoutes   DawRoute[]          @relation("DawRouteSource")
  incomingRoutes   DawRoute[]          @relation("DawRouteDestination")
  automationLanes  DawAutomationLane[]

  @@index([projectId])
  @@index([trackType])
}

model DawClip {
  id                   String    @id @default(cuid())
  trackId              String
  audioFileId          String
  startSeconds         Float     @default(0)
  offsetSeconds        Float     @default(0)
  durationSeconds      Float?
  gain                 Float     @default(1)
  fadeInSeconds        Float     @default(0)
  fadeOutSeconds       Float     @default(0)
  locked               Boolean   @default(false)
  label                String?
  color                String?
  groupId              String?
  zeroCrossingAdjusted Boolean   @default(false)
  crossfadeGroupId     String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  track                DawTrack  @relation(fields: [trackId], references: [id], onDelete: Cascade)
  audioFile            AudioFile @relation(fields: [audioFileId], references: [id], onDelete: Cascade)

  @@index([trackId])
  @@index([audioFileId])
  @@index([groupId])
  @@index([crossfadeGroupId])
}

model DawTakeLane {
  id                String               @id @default(cuid())
  trackId           String
  recordingTakeId   String
  laneOrder         Int                  @default(0)
  compStatus        String               @default("candidate")
  selectedRangeJson String?
  notes             String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  track             DawTrack             @relation(fields: [trackId], references: [id], onDelete: Cascade)
  recordingTake     RecordingTake        @relation(fields: [recordingTakeId], references: [id], onDelete: Cascade)
  compSegments      DawTakeCompSegment[]

  @@index([trackId])
  @@index([recordingTakeId])
  @@index([compStatus])
}

model DawTakeCompSegment {
  id                   String      @id @default(cuid())
  takeLaneId           String
  sourceStartSeconds   Float
  sourceEndSeconds     Float
  timelineStartSeconds Float
  fadeInSeconds        Float       @default(0.01)
  fadeOutSeconds       Float       @default(0.01)
  sortOrder            Int         @default(0)
  active               Boolean     @default(true)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  takeLane             DawTakeLane @relation(fields: [takeLaneId], references: [id], onDelete: Cascade)

  @@index([takeLaneId])
  @@index([timelineStartSeconds])
}

model DawMarker {
  id               String     @id @default(cuid())
  projectId        String
  markerType       String     @default("idea")
  label            String
  timestampSeconds Float      @default(0)
  color            String?
  relatedModel     String?
  relatedId        String?
  notes            String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  project          DawProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([markerType])
  @@index([timestampSeconds])
}

model DawMixSnapshot {
  id           String     @id @default(cuid())
  projectId    String
  title        String
  snapshotJson String
  createdAt    DateTime   @default(now())
  project      DawProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([createdAt])
}

model DawLatencyProfile {
  id                  String     @id @default(cuid())
  projectId           String
  inputDeviceName     String
  outputDeviceName    String
  sampleRate          Int
  bufferFrames        Int
  measuredRoundTripMs Float
  inputLatencyMs      Float?
  outputLatencyMs     Float?
  compensationMs      Float
  method              String     @default("acoustic_loopback")
  confidence          Float      @default(0)
  isActive            Boolean    @default(true)
  measurementJson     String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  project             DawProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([inputDeviceName, outputDeviceName])
  @@index([sampleRate, bufferFrames])
}

model DawEngineHealthSnapshot {
  id                   String     @id @default(cuid())
  projectId            String
  recordingId          String?
  status               String     @default("healthy")
  peak                 Float      @default(0)
  rms                  Float      @default(0)
  truePeak             Float?
  clipping             Boolean    @default(false)
  xrunCount            Int        @default(0)
  inputOverflowCount   Int        @default(0)
  outputUnderflowCount Int        @default(0)
  diskWriteErrorCount  Int        @default(0)
  callbackLoad         Float      @default(0)
  freeDiskBytes        BigInt?
  detailsJson          String?
  createdAt            DateTime   @default(now())
  project              DawProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([recordingId])
  @@index([status])
  @@index([createdAt])
}

model DawEditOperation {
  id            String     @id @default(cuid())
  projectId     String
  sequence      Int
  groupId       String?
  operationType String
  entityType    String
  entityId      String?
  label         String
  beforeJson    String?
  afterJson     String?
  status        String     @default("APPLIED")
  createdAt     DateTime   @default(now())
  undoneAt      DateTime?
  project       DawProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, sequence])
  @@index([projectId, status])
  @@index([groupId])
}

model DawRoute {
  id                 String     @id @default(cuid())
  projectId          String
  sourceTrackId      String?
  destinationTrackId String?
  routeType          String     @default("output")
  name               String
  preFader           Boolean    @default(false)
  gain               Float      @default(1)
  pan                Float      @default(0)
  muted              Boolean    @default(false)
  sortOrder          Int        @default(0)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  project            DawProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceTrack        DawTrack?  @relation("DawRouteSource", fields: [sourceTrackId], references: [id], onDelete: Cascade)
  destinationTrack   DawTrack?  @relation("DawRouteDestination", fields: [destinationTrackId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([sourceTrackId])
  @@index([destinationTrackId])
  @@index([routeType])
}

model DawAutomationLane {
  id        String               @id @default(cuid())
  trackId   String
  parameter String
  mode      String               @default("read")
  enabled   Boolean              @default(true)
  minValue  Float                @default(0)
  maxValue  Float                @default(1)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  track     DawTrack             @relation(fields: [trackId], references: [id], onDelete: Cascade)
  points    DawAutomationPoint[]

  @@unique([trackId, parameter])
  @@index([trackId])
  @@index([mode])
}

model DawAutomationPoint {
  id          String            @id @default(cuid())
  laneId      String
  timeSeconds Float
  value       Float
  curve       String            @default("linear")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  lane        DawAutomationLane @relation(fields: [laneId], references: [id], onDelete: Cascade)

  @@index([laneId])
  @@index([timeSeconds])
}

model DawRecoveryEntry {
  id          String     @id @default(cuid())
  projectId   String
  sessionId   String
  sequence    Int
  eventType   String
  payloadJson String
  status      String     @default("PENDING")
  createdAt   DateTime   @default(now())
  resolvedAt  DateTime?
  project     DawProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, sessionId, sequence])
  @@index([projectId, status])
  @@index([sessionId])
  @@index([createdAt])
}

model DawScoreDraft {
  id                String     @id @default(cuid())
  projectId         String
  sourceAudioFileId String?
  title             String
  targetInstrument  String
  analyzer          String     @default("songzu_local_dsp_v1")
  status            String     @default("DRAFT")
  confidence        Float      @default(0)
  bpm               Int?
  musicalKey        String?
  timeSignature     String     @default("4/4")
  durationSeconds   Float?
  resultJson        String
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  project           DawProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceAudioFile   AudioFile? @relation(fields: [sourceAudioFileId], references: [id], onDelete: SetNull)
  formalReleases    DawScoreRelease[]

  @@index([projectId])
  @@index([sourceAudioFileId])
  @@index([targetInstrument])
  @@index([status])
  @@index([createdAt])
}

model DawScoreRelease {
  id                       String        @id @default(cuid())
  scoreDraftId             String
  revision                 Int
  formalContentSha256      String
  contentHashVersion       String        @default("songzu_formal_score_v2")
  resultJson               String
  textSha256               String?
  pdfSha256                String?
  artifactGeneratedAt      DateTime?
  releasedAt               DateTime
  releasedBy               String
  confirmationEvidenceJson String?
  createdAt                DateTime      @default(now())
  scoreDraft               DawScoreDraft @relation(fields: [scoreDraftId], references: [id], onDelete: Cascade)

  @@unique([scoreDraftId, revision])
  @@index([scoreDraftId, releasedAt])
  @@index([formalContentSha256])
}

model Contributor {
  id             String   @id @default(cuid())
  name           String
  email          String?
  phone          String?
  ipi            String?
  isni           String?
  proAffiliation String?
  countryCode    String?
  defaultRoles   String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  credits        Credit[]

  @@index([name])
}

model Credit {
  id              String               @id @default(cuid())
  songId          String
  contributorId   String
  role            String
  splitPercentage Float?
  publishingSplit Float?
  masterSplit     Float?
  creditCategory  String?
  ownershipType   String?
  notes           String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  song            Song                 @relation(fields: [songId], references: [id], onDelete: Cascade)
  contributor     Contributor          @relation(fields: [contributorId], references: [id], onDelete: Cascade)
  confirmations   CreditConfirmation[]

  @@index([songId])
  @@index([contributorId])
}

model CreditConfirmation {
  id            String    @id @default(cuid())
  creditId      String
  token         String    @unique
  status        String    @default("PENDING")
  confirmedAt   DateTime?
  displayName   String?
  emailSnapshot String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  credit        Credit    @relation(fields: [creditId], references: [id], onDelete: Cascade)

  @@index([creditId])
  @@index([status])
}

model Release {
  id              String                 @id @default(cuid())
  title           String
  releaseType     String                 @default("SINGLE")
  releaseDate     DateTime?
  status          String                 @default("PLANNING")
  upc             String?
  coverArtFileId  String?
  copyrightLine   String?
  publishingLine  String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  tracks          ReleaseTrack[]
  checklistItems  ReleaseChecklistItem[]
  songPreviews    SongPreview[]
  industryExports IndustryExport[]

  @@index([status])
  @@index([releaseDate])
}

model ReleaseChecklistItem {
  id        String   @id @default(cuid())
  releaseId String
  title     String
  category  String
  status    String   @default("TODO")
  required  Boolean  @default(true)
  sortOrder Int      @default(0)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  release   Release  @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@index([releaseId])
  @@index([status])
}

model ReleaseTrack {
  id           String   @id @default(cuid())
  releaseId    String
  songId       String
  trackNumber  Int
  isrc         String?
  displayTitle String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  release      Release  @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  song         Song     @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@index([releaseId])
  @@index([songId])
}

model Task {
  id          String    @id @default(cuid())
  songId      String
  title       String
  status      String    @default("TODO")
  category    String?
  dueDate     DateTime?
  sortOrder   Int       @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  song        Song      @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@index([songId])
  @@index([status])
}

model StatusHistory {
  id         String   @id @default(cuid())
  songId     String
  fromStatus String?
  toStatus   String
  note       String?
  changedAt  DateTime @default(now())
  song       Song     @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@index([songId])
}

model AiSuggestion {
  id                String    @id @default(cuid())
  songId            String?
  suggestionType    String
  status            String    @default("pending")
  inputSnapshotJson String?
  outputPayloadJson String?
  createdAt         DateTime  @default(now())
  appliedAt         DateTime?
  song              Song?     @relation(fields: [songId], references: [id], onDelete: SetNull)

  @@index([songId])
  @@index([suggestionType])
}

model AiConversation {
  id        String          @id @default(cuid())
  title     String
  provider  String?
  model     String?
